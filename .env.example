# --- Vector DB ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=documents

# --- Ollama (runs natively on the host by default; see docs/SETUP.md for the docker profile) ---
OLLAMA_URL=http://127.0.0.1:11434
EMBED_MODEL=bge-m3
EMBED_DIM=1024
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1

# --- Anthropic (optional, LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Pipeline defaults ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
CONTEXT_MAX_CHARS=12000

# --- API ---
PORT=3000

# --- Postgres (used from step 9 onwards) ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
DATABASE_URL=postgres://rag:rag@127.0.0.1:5432/rag

# --- MinIO / S3 (used from step 9 onwards) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
